#!/bin/sh
# generated by retailgate netpolicy --format iptables
# chain GEDEFENSE_GATE in FORWARD: new management connections to protected
# controllers are accepted only from the listed gate sources; everything else
# is logged and dropped. Re-applying this script is idempotent.
# Honest limit: only traffic that traverses this host is enforced (routing/NAT/bridge required).
# protected endpoints: 10.0.0.5:502, 10.0.0.6:502, 2001:db8::10:8443
# gate sources: 10.20.30.40/32, 2001:db8:100::/64
set -eu

# --- iptables ---
iptables -w -N GEDEFENSE_GATE 2>/dev/null || true
while iptables -w -C FORWARD -j GEDEFENSE_GATE 2>/dev/null; do iptables -w -D FORWARD -j GEDEFENSE_GATE; done
iptables -w -I FORWARD 1 -j GEDEFENSE_GATE
iptables -w -F GEDEFENSE_GATE
iptables -w -A GEDEFENSE_GATE -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -w -A GEDEFENSE_GATE -s 10.20.30.40/32 -p tcp -d 10.0.0.5 --dport 502 -m comment --comment "retailgate target=regler-1 proto=tcp port=502 protocol=modbus_tcp" -j ACCEPT
iptables -w -A GEDEFENSE_GATE -p tcp -d 10.0.0.5 --dport 502 -m comment --comment "retailgate: deny non-gate sources" -j LOG --log-prefix "gedefense-gate-drop "
iptables -w -A GEDEFENSE_GATE -p tcp -d 10.0.0.5 --dport 502 -j DROP
iptables -w -A GEDEFENSE_GATE -s 10.20.30.40/32 -p tcp -d 10.0.0.6 --dport 502 -m comment --comment "retailgate target=regler-2 proto=tcp port=502 protocol=modbus_tcp" -j ACCEPT
iptables -w -A GEDEFENSE_GATE -p tcp -d 10.0.0.6 --dport 502 -m comment --comment "retailgate: deny non-gate sources" -j LOG --log-prefix "gedefense-gate-drop "
iptables -w -A GEDEFENSE_GATE -p tcp -d 10.0.0.6 --dport 502 -j DROP

# --- ip6tables ---
ip6tables -w -N GEDEFENSE_GATE 2>/dev/null || true
while ip6tables -w -C FORWARD -j GEDEFENSE_GATE 2>/dev/null; do ip6tables -w -D FORWARD -j GEDEFENSE_GATE; done
ip6tables -w -I FORWARD 1 -j GEDEFENSE_GATE
ip6tables -w -F GEDEFENSE_GATE
ip6tables -w -A GEDEFENSE_GATE -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
ip6tables -w -A GEDEFENSE_GATE -s 2001:db8:100::/64 -p tcp -d 2001:db8::10 --dport 8443 -m comment --comment "retailgate target=hmi-1 proto=tcp port=8443 protocol=https" -j ACCEPT
ip6tables -w -A GEDEFENSE_GATE -p tcp -d 2001:db8::10 --dport 8443 -m comment --comment "retailgate: deny non-gate sources" -j LOG --log-prefix "gedefense-gate-drop "
ip6tables -w -A GEDEFENSE_GATE -p tcp -d 2001:db8::10 --dport 8443 -j DROP

# end of generated ruleset

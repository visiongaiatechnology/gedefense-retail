# generated by retailgate netpolicy --format nftables
# table gedefense_gate: new management connections to protected controllers
# are accepted only from the listed gate sources; everything else is logged and dropped.
# Honest limit: only traffic that traverses this host is enforced (routing/NAT/bridge required).
# protected endpoints: 10.0.0.5:502, 10.0.0.6:502, 2001:db8::10:8443
# gate sources: 10.20.30.40/32, 2001:db8:100::/64

table inet gedefense_gate {
	set gate_sources_v4 {
		type ipv4_addr
		flags interval
		elements = { 10.20.30.40/32 }
	}

	set gate_sources_v6 {
		type ipv6_addr
		flags interval
		elements = { 2001:db8:100::/64 }
	}

	set protected_v4 {
		type ipv4_addr . inet_service
		flags interval
		elements = { 10.0.0.5 . 502, 10.0.0.6 . 502 }
	}

	set protected_v6 {
		type ipv6_addr . inet_service
		flags interval
		elements = { 2001:db8::10 . 8443 }
	}

	chain forward {
		type filter hook forward priority -5; policy accept;
		ct state established,related accept comment "retailgate: return traffic of allowed sessions"
		ip saddr @gate_sources_v4 ip daddr . tcp dport @protected_v4 accept comment "retailgate: gate source -> protected controller"
		ip6 saddr @gate_sources_v6 ip6 daddr . tcp dport @protected_v6 accept comment "retailgate: gate source -> protected controller"
		ip daddr . tcp dport @protected_v4 log prefix "gedefense-gate-drop " flags all counter drop comment "retailgate: direct access to protected controller denied"
		ip6 daddr . tcp dport @protected_v6 log prefix "gedefense-gate-drop " flags all counter drop comment "retailgate: direct access to protected controller denied"
	}
}
